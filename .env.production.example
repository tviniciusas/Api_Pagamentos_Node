# Copy to /opt/payment-api/.env on the server. Never commit the real file.

# Image published by the pipeline (owner is lowercased by the workflow)
IMAGE=ghcr.io/tviniciusas/api_pagamentos_node
IMAGE_TAG=latest

# Database (internal container, port not exposed to the host)
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-password
DB_NAME=payment_db

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=your_access_token_here
MERCADO_PAGO_SANDBOX=true
# Public URL of this API; used for webhook and back_urls
APP_URL=https://api.example.com
MERCADO_PAGO_WEBHOOK_URL=https://api.example.com/api/webhook/mercado-pago

# Temporal
TEMPORAL_PAYMENT_TIMEOUT_MINUTES=30
